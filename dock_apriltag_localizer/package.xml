<?xml version="1.0"?>
<package format="3">
  <name>dock_apriltag_localizer</name>
  <version>0.1.0</version>
  <description>Multi-AprilTag two-stage docking localizer.</description>
  <maintainer email="user@example.com">Enrico</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>apriltag</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <exec_depend>camera_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
