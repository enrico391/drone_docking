# Simulation adaptation: first logged battery voltage before flight (16.030447 V).
# SITL adds its existing simple throttle-dependent voltage drop; this is not a
# fitted battery model and does not make Gazebo motor thrust voltage-dependent.
SIM_BATT_VOLTAGE     16.030447
