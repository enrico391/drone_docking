# X500 uses the standard ArduPilot Quad-X motor order.
FRAME_CLASS      1
FRAME_TYPE       1

# Match the PWM range configured in the ArduPilot Gazebo control channels.
MOT_PWM_MIN      1100
MOT_PWM_MAX      1900

# Enable the companion-computer precision-landing backend. It remains idle
# unless LANDING_TARGET messages arrive and the vehicle enters LAND/RTL.
PLND_ENABLED     1
PLND_TYPE        1

# disable kalman filter for landing target position estimation, use raw vision data instead
PLND_EST_TYPE       0

# change max distance to which the drone can discend
PLND_XY_DIST_MAX    0.25

# change max speed at which the drone can discend
LAND_SPD_MS         0.25

# Geographic reference for the future docking station (latitude, longitude,
# and altitude above mean sea level).
SIM_OPOS_LAT        45.3821944
SIM_OPOS_LNG        12.0005833
SIM_OPOS_ALT        2.0


PLND_ENABLED = 1
PLND_TYPE    = 1
LOG_DISARMED = 1
