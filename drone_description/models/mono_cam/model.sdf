<?xml version="1.0"?>
<sdf version="1.9">
  <model name="mono_cam">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>

      <visual name="housing_visual">
        <geometry>
          <box>
            <size>0.02 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.09 0.10 1</ambient>
          <diffuse>0.12 0.13 0.14 1</diffuse>
        </material>
      </visual>
      <visual name="lens_visual">
        <pose>0.015 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.08 0.12 1</ambient>
          <diffuse>0.08 0.12 0.18 1</diffuse>
        </material>
      </visual>

      <sensor name="down_camera" type="camera">
        <camera>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>30</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- ROS optical frame: Z forward, X right, Y down. Gazebo's camera_link
         uses X forward, Y left, Z up. -->
    <link name="camera_optical_frame">
      <pose relative_to="camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
      <inertial>
        <mass>0.000001</mass>
        <inertia>
          <ixx>0.000000001</ixx>
          <iyy>0.000000001</iyy>
          <izz>0.000000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="CameraOpticalJoint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_optical_frame</child>
    </joint>
  </model>
</sdf>
