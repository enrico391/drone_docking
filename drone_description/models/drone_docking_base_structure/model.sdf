<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_docking_base_structure">
    <static>true</static>

    <!--
      Coordinate frame
      - Model origin is on the ground at the center of the 660 x 660 mm central block.
      - +Z is upward.
      - The open front cavity faces +X.

      Main editable dimensions
      - central block outer size      : 0.660 x 0.660 x 0.350 m
      - wall thickness                : 0.030 m
      - top recess opening            : 0.320 x 0.320 m
      - top recess floor height       : z = 0.280 m (top surface at z = 0.350 m)
      - outer AprilTag size           : 0.300 x 0.300 m
      - outer AprilTag centers        : (+/-0.520, +/-0.520) m
      - center AprilTag size          : 0.120 x 0.120 m
      - center AprilTag center        : (0, 0) on top recess floor
    -->

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- ===================== -->
      <!-- Main hollow base body -->
      <!-- ===================== -->

      <!-- Bottom slab -->
      <collision name="bottom_collision">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><box><size>0.660 0.660 0.030</size></box></geometry>
      </collision>
      <visual name="bottom_visual">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><box><size>0.660 0.660 0.030</size></box></geometry>
        <material>
          <ambient>0.35 0.35 0.35 1</ambient>
          <diffuse>0.45 0.45 0.45 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <!-- Left and right walls -->
      <collision name="left_wall_collision">
        <pose>0 0.315 0.190 0 0 0</pose>
        <geometry><box><size>0.660 0.030 0.320</size></box></geometry>
      </collision>
      <visual name="left_wall_visual">
        <pose>0 0.315 0.190 0 0 0</pose>
        <geometry><box><size>0.660 0.030 0.320</size></box></geometry>
        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.52 0.52 0.52 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <collision name="right_wall_collision">
        <pose>0 -0.315 0.190 0 0 0</pose>
        <geometry><box><size>0.660 0.030 0.320</size></box></geometry>
      </collision>
      <visual name="right_wall_visual">
        <pose>0 -0.315 0.190 0 0 0</pose>
        <geometry><box><size>0.660 0.030 0.320</size></box></geometry>
        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.52 0.52 0.52 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <!-- Back wall (front is intentionally open) -->
      <collision name="back_wall_collision">
        <pose>-0.315 0 0.190 0 0 0</pose>
        <geometry><box><size>0.030 0.600 0.320</size></box></geometry>
      </collision>
      <visual name="back_wall_visual">
        <pose>-0.315 0 0.190 0 0 0</pose>
        <geometry><box><size>0.030 0.600 0.320</size></box></geometry>
        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.52 0.52 0.52 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <!-- ====================== -->
      <!-- Top landing recess rim -->
      <!-- ====================== -->

      <!-- Top rim strips around a 320 x 320 mm opening -->
      <collision name="top_front_strip_collision">
        <pose>0.245 0 0.335 0 0 0</pose>
        <geometry><box><size>0.170 0.660 0.030</size></box></geometry>
      </collision>
      <visual name="top_front_strip_visual">
        <pose>0.245 0 0.335 0 0 0</pose>
        <geometry><box><size>0.170 0.660 0.030</size></box></geometry>
        <material>
          <ambient>0.50 0.50 0.50 1</ambient>
          <diffuse>0.62 0.62 0.62 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <collision name="top_back_strip_collision">
        <pose>-0.245 0 0.335 0 0 0</pose>
        <geometry><box><size>0.170 0.660 0.030</size></box></geometry>
      </collision>
      <visual name="top_back_strip_visual">
        <pose>-0.245 0 0.335 0 0 0</pose>
        <geometry><box><size>0.170 0.660 0.030</size></box></geometry>
        <material>
          <ambient>0.50 0.50 0.50 1</ambient>
          <diffuse>0.62 0.62 0.62 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <collision name="top_left_strip_collision">
        <pose>0 0.245 0.335 0 0 0</pose>
        <geometry><box><size>0.320 0.170 0.030</size></box></geometry>
      </collision>
      <visual name="top_left_strip_visual">
        <pose>0 0.245 0.335 0 0 0</pose>
        <geometry><box><size>0.320 0.170 0.030</size></box></geometry>
        <material>
          <ambient>0.50 0.50 0.50 1</ambient>
          <diffuse>0.62 0.62 0.62 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <collision name="top_right_strip_collision">
        <pose>0 -0.245 0.335 0 0 0</pose>
        <geometry><box><size>0.320 0.170 0.030</size></box></geometry>
      </collision>
      <visual name="top_right_strip_visual">
        <pose>0 -0.245 0.335 0 0 0</pose>
        <geometry><box><size>0.320 0.170 0.030</size></box></geometry>
        <material>
          <ambient>0.50 0.50 0.50 1</ambient>
          <diffuse>0.62 0.62 0.62 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <!-- Recess floor -->
      <collision name="recess_floor_collision">
        <pose>0 0 0.280 0 0 0</pose>
        <geometry><box><size>0.320 0.320 0.020</size></box></geometry>
      </collision>
      <visual name="recess_floor_visual">
        <pose>0 0 0.280 0 0 0</pose>
        <geometry><box><size>0.320 0.320 0.020</size></box></geometry>
        <material>
          <ambient>0.35 0.35 0.35 1</ambient>
          <diffuse>0.45 0.45 0.45 1</diffuse>
          <specular>0.06 0.06 0.06 1</specular>
        </material>
      </visual>

      <!-- Recess inner walls -->
      <collision name="recess_wall_posx_collision">
        <pose>0.170 0 0.315 0 0 0</pose>
        <geometry><box><size>0.020 0.320 0.050</size></box></geometry>
      </collision>
      <visual name="recess_wall_posx_visual">
        <pose>0.170 0 0.315 0 0 0</pose>
        <geometry><box><size>0.020 0.320 0.050</size></box></geometry>
        <material>
          <ambient>0.42 0.42 0.42 1</ambient>
          <diffuse>0.54 0.54 0.54 1</diffuse>
          <specular>0.07 0.07 0.07 1</specular>
        </material>
      </visual>

      <collision name="recess_wall_negx_collision">
        <pose>-0.170 0 0.315 0 0 0</pose>
        <geometry><box><size>0.020 0.320 0.050</size></box></geometry>
      </collision>
      <visual name="recess_wall_negx_visual">
        <pose>-0.170 0 0.315 0 0 0</pose>
        <geometry><box><size>0.020 0.320 0.050</size></box></geometry>
        <material>
          <ambient>0.42 0.42 0.42 1</ambient>
          <diffuse>0.54 0.54 0.54 1</diffuse>
          <specular>0.07 0.07 0.07 1</specular>
        </material>
      </visual>

      <collision name="recess_wall_posy_collision">
        <pose>0 0.170 0.315 0 0 0</pose>
        <geometry><box><size>0.320 0.020 0.050</size></box></geometry>
      </collision>
      <visual name="recess_wall_posy_visual">
        <pose>0 0.170 0.315 0 0 0</pose>
        <geometry><box><size>0.320 0.020 0.050</size></box></geometry>
        <material>
          <ambient>0.42 0.42 0.42 1</ambient>
          <diffuse>0.54 0.54 0.54 1</diffuse>
          <specular>0.07 0.07 0.07 1</specular>
        </material>
      </visual>

      <collision name="recess_wall_negy_collision">
        <pose>0 -0.170 0.315 0 0 0</pose>
        <geometry><box><size>0.320 0.020 0.050</size></box></geometry>
      </collision>
      <visual name="recess_wall_negy_visual">
        <pose>0 -0.170 0.315 0 0 0</pose>
        <geometry><box><size>0.320 0.020 0.050</size></box></geometry>
        <material>
          <ambient>0.42 0.42 0.42 1</ambient>
          <diffuse>0.54 0.54 0.54 1</diffuse>
          <specular>0.07 0.07 0.07 1</specular>
        </material>
      </visual>

      <!-- ======================= -->
      <!-- Front charging bar cue -->
      <!-- ======================= -->

      <visual name="front_blue_mount_visual">
        <pose>0.240 0 0.135 0 0 0</pose>
        <geometry><box><size>0.030 0.030 0.030</size></box></geometry>
        <material>
          <ambient>0.05 0.35 0.70 1</ambient>
          <diffuse>0.10 0.50 0.90 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <visual name="front_contact_bar_visual">
        <pose>0.240 0 0.115 0 0 0</pose>
        <geometry><box><size>0.020 0.240 0.020</size></box></geometry>
        <material>
          <ambient>0.70 0.10 0.10 1</ambient>
          <diffuse>0.90 0.20 0.20 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- =================== -->
      <!-- AprilTag visuals    -->
      <!-- =================== -->

      <!-- Center tag inside the top recess -->
      <visual name="apriltag_center">
        <pose>0 0 0.291 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.120 0.120 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/tag36h11_4.png</albedo_map>
            <metalness>0.0</metalness><roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <!-- Outer ground tags: viewed from above ID0 NE, ID1 NW, ID2 SW, ID3 SE -->
      <visual name="apriltag_0_NE">
        <pose>0.520 0.520 0.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/tag36h11_0.png</albedo_map>
            <metalness>0.0</metalness><roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <visual name="apriltag_1_NW">
        <pose>-0.520 0.520 0.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/tag36h11_1.png</albedo_map>
            <metalness>0.0</metalness><roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <visual name="apriltag_2_SW">
        <pose>-0.520 -0.520 0.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/tag36h11_2.png</albedo_map>
            <metalness>0.0</metalness><roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <visual name="apriltag_3_SE">
        <pose>0.520 -0.520 0.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/tag36h11_3.png</albedo_map>
            <metalness>0.0</metalness><roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
