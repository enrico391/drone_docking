<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_docking_base_structure">
    <static>true</static>

    <!--
      Coordinate frame
      - Model origin is centered on the dock at ground level.
      - +Z is upward.
      - The Fusion STL spans 1.600 x 1.600 x 1.060 m.
      - Its exported Z range is -0.000235591..1.059764385 m, so the
        mesh is translated upward by 0.000235591 m to place it on z=0.
      - Outer AprilTags lie on the large z=1.000 m surface.
      - The center AprilTag lies on the z=0.880 m recess floor.
    -->

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <!--
        Stable collision proxy for the dock body and central recess.

        The visual STL is a concave, close-fitting CAD mesh. Using it as a
        collider against the dynamic triangular-base STL creates invalid
        interior contacts in Bullet. The boxes below retain the load-bearing
        surfaces while leaving an 800 mm square physics opening around the
        insert. The larger invisible opening keeps Bullet's contact margin
        away from the vehicle body during passive settling and takeoff.
      -->
      <collision name="lower_body_collision">
        <pose>0 0 0.440 0 0 0</pose>
        <geometry>
          <box>
            <size>1.600 1.600 0.880</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- The upper deck starts outside a 0.8 m square clearance envelope.
           This keeps its collision geometry away from the X500 body and
           propeller links while preserving the deck for external contacts. -->
      <collision name="top_north_collision">
        <pose>0 0.600 0.940 0 0 0</pose>
        <geometry><box><size>1.600 0.400 0.120</size></box></geometry>
      </collision>
      <collision name="top_south_collision">
        <pose>0 -0.600 0.940 0 0 0</pose>
        <geometry><box><size>1.600 0.400 0.120</size></box></geometry>
      </collision>
      <collision name="top_east_collision">
        <pose>0.600 0 0.940 0 0 0</pose>
        <geometry><box><size>0.400 0.800 0.120</size></box></geometry>
      </collision>
      <collision name="top_west_collision">
        <pose>-0.600 0 0.940 0 0 0</pose>
        <geometry><box><size>0.400 0.800 0.120</size></box></geometry>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0.00023559096734970808 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://drone_docking_base_structure/meshes/base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.35 1</ambient>
          <diffuse>0.50 0.50 0.50 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <!-- Center tag ID4 on the 120 mm recess floor. -->
      <visual name="apriltag_center">
        <pose>0 0 0.881 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.120 0.120 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>model://drone_docking_base_structure/materials/textures/tag36h11_4.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <!-- Outer tags on the large top surface: ID0 NE, ID1 NW, ID2 SW, ID3 SE. -->
      <visual name="apriltag_0_NE">
        <pose>0.520 0.520 1.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>model://drone_docking_base_structure/materials/textures/tag36h11_0.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <visual name="apriltag_1_NW">
        <pose>-0.520 0.520 1.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>model://drone_docking_base_structure/materials/textures/tag36h11_1.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <visual name="apriltag_2_SW">
        <pose>-0.520 -0.520 1.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>model://drone_docking_base_structure/materials/textures/tag36h11_2.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <visual name="apriltag_3_SE">
        <pose>0.520 -0.520 1.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://drone_docking_base_structure/meshes/tag_plane.obj</uri>
            <scale>0.300 0.300 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>model://drone_docking_base_structure/materials/textures/tag36h11_3.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
