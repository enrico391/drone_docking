          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <!-- ArduPilot expects IMU axes in forward-right-down body coordinates. -->
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
      </sensor>
