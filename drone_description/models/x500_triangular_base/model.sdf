    <link name="triangular_base_link">
      <!-- Flip the Fusion mesh and rotate it 90 degrees in yaw. The origin moves
           to base_link so the flipped mesh still spans z=-0.208..0 m. -->
      <pose relative_to="base_link">0 0 0 3.14159265359 0 1.57079632679</pose>
      <inertial>
        <!-- Fusion 360 values converted from g/mm to kg/m SI units. -->
        <pose>-0.000011 0.000805 0.097709 0 0 0</pose>
        <mass>0.990387</mass>
        <inertia>
          <ixx>0.006604</ixx>
          <ixy>-0.000000005161</ixy>
          <ixz>0.000000260181</ixz>
          <iyy>0.006651</iyy>
          <iyz>0.000030921471</iyz>
          <izz>0.006982</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <visual name="triangular_base_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_triangular_base/meshes/triangular_base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <!-- Exact mating geometry; requires Bullet Featherstone physics. -->
      <collision name="triangular_base_collision">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_triangular_base/meshes/triangular_base.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="triangular_base_joint" type="fixed">
      <parent>base_link</parent>
      <child>triangular_base_link</child>
    </joint>
